http:
{% if traefik_fusion_enabled | default(true) %}
  routers:
    fusion:
      rule: "Host(`{{ traefik_fusion_domain | default('fusion.mini.debrutal.dev') }}`)"
      entryPoints:
        - websecure
      service: fusion-service
{% if traefik_acme_enabled %}
      tls:
        certResolver: letsencrypt
{% else %}
      tls: {}
{% endif %}

  services:
    fusion-service:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:{{ traefik_fusion_target_port | default(4040) }}"
{% endif %}

  middlewares:
    security-headers:
      headers:
        frameDeny: true
        sslRedirect: {{ traefik_acme_enabled | lower }}
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000

    authentik:
      forwardAuth:
        address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - "X-authentik-username"
          - "X-authentik-groups"
          - "X-authentik-email"
          - "X-authentik-name"
          - "X-authentik-uid"
          - "X-authentik-jwt"
          - "Authorization"

{% if traefik_acme_enabled %}
tls:
  stores:
    default:
      defaultGeneratedCert:
        resolver: letsencrypt
        domain:
          main: "{{ traefik_acme_domain_main }}"
          sans:
{% for san in traefik_acme_domain_sans %}
            - "{{ san }}"
{% endfor %}
{% endif %}
