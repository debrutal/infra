http:
  middlewares:
    security-headers:
      headers:
        frameDeny: true
        sslRedirect: {{ traefik_acme_enabled | lower }}
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000

    authentik:
      forwardAuth:
        address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - "X-authentik-username"
          - "X-authentik-groups"
          - "X-authentik-email"
          - "X-authentik-name"
          - "X-authentik-uid"
          - "X-authentik-jwt"
          - "Authorization"

{% if traefik_acme_enabled %}
tls:
{% if traefik_acme_kitakit_token is defined and traefik_acme_kitakit_token != '' and not (traefik_acme_kitakit_token | string).startswith('{{') %}
  certificates:
    - certFile: /etc/traefik/certs/certificates/staging.kita-kit.de.crt
      keyFile: /etc/traefik/certs/certificates/staging.kita-kit.de.key
{% endif %}
  stores:
    default:
      defaultGeneratedCert:
        resolver: letsencrypt
        domain:
          main: "{{ traefik_acme_domain_main }}"
          sans:
{% for san in traefik_acme_domain_sans %}
            - "{{ san }}"
{% endfor %}
{% endif %}
