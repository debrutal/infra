services:
  gitea:
    image: gitea/gitea:{{ gitea_version }}
    container_name: gitea
    restart: always
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__server__ROOT_URL={{ gitea_site_url }}/
      - GITEA__server__DOMAIN={{ gitea_domain }}
      - GITEA__server__SSH_DOMAIN={{ gitea_domain }}
      - GITEA__server__SSH_PORT={{ gitea_ssh_port }}
      - GITEA__server__HTTP_PORT=3000
      - GITEA__service__DISABLE_REGISTRATION=false
      - GITEA__actions__ENABLED=true
      - GITEA__packages__ENABLED=true
      - GITEA__security__EGRESS_MODE={{ gitea_security_egress_mode | default('lax') }}
      - GITEA__security__ALLOWED_HOST_LIST={{ gitea_security_allowed_host_list | default('loopback,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8') }}
{% if gitea_otel_enabled | default(true) %}
      - GITEA__opentelemetry__ENABLED=true
      - GITEA__opentelemetry__EXPORTER=otlp
      - GITEA__opentelemetry__ENDPOINT=otel-collector:4317
      - GITEA__opentelemetry__PROTOCOL=grpc
      - GITEA__opentelemetry__INSECURE=true
      - GITEA__opentelemetry__SERVICE_NAME=gitea
{% endif %}
    volumes:
      - {{ gitea_dir }}/data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ gitea_ssh_port }}:22"
    networks:
      - default
      - traefik_net
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.gitea.rule=Host(`{{ gitea_domain }}`)"
      - "traefik.http.routers.gitea.entrypoints={{ gitea_traefik_entrypoints }}"
{% if traefik_acme_enabled | default(true) %}
      - "traefik.http.routers.gitea.tls=true"
{% if gitea_traefik_certresolver is defined and gitea_traefik_certresolver %}
      - "traefik.http.routers.gitea.tls.certresolver={{ gitea_traefik_certresolver }}"
{% endif %}
{% endif %}
      - "traefik.http.services.gitea.loadbalancer.server.port=3000"
      - "kuma.gitea.http.name=Gitea"
      - "kuma.gitea.http.url=http://gitea:3000"
      - "homepage.group=Development & CI"
      - "homepage.name=Gitea"
      - "homepage.icon=gitea"
      - "homepage.href={{ gitea_site_url }}"
      - "homepage.description=Self-Hosted Git Service"

{% if gitea_mcp_enabled | default(true) %}
  gitea-mcp:
    image: {{ gitea_mcp_image | default('docker.gitea.com/gitea-mcp-server:latest') }}
    container_name: gitea-mcp
    restart: always
    environment:
      - MCP_MODE=http
      - GITEA_HOST=http://gitea:3000
      - GITEA_ACCESS_TOKEN={{ gitea_mcp_access_token }}
{% if gitea_mcp_readonly | default(false) %}
      - GITEA_READONLY=true
{% endif %}
    healthcheck:
      test: ["CMD", "/app/gitea-mcp", "-healthcheck"]
      interval: 15s
      timeout: 3s
      retries: 3
      start_period: 5s
    depends_on:
      - gitea

    networks:
      - default
      - traefik_net
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.gitea-mcp.rule=Host(`{{ gitea_mcp_domain }}`)"
      - "traefik.http.routers.gitea-mcp.entrypoints={{ gitea_traefik_entrypoints }}"
{% if traefik_acme_enabled | default(true) %}
      - "traefik.http.routers.gitea-mcp.tls=true"
{% if gitea_traefik_certresolver is defined and gitea_traefik_certresolver %}
      - "traefik.http.routers.gitea-mcp.tls.certresolver={{ gitea_traefik_certresolver }}"
{% endif %}
{% endif %}
      - "traefik.http.services.gitea-mcp.loadbalancer.server.port={{ gitea_mcp_port | default(8080) }}"
      - "kuma.gitea-mcp.http.name=Gitea MCP"
      - "kuma.gitea-mcp.http.url=http://gitea-mcp:8080/healthz"
      - "homepage.group=Development & CI"
      - "homepage.name=Gitea MCP"
      - "homepage.icon=gitea"
      - "homepage.href={{ gitea_mcp_site_url }}"
      - "homepage.description=Gitea MCP Server"
{% endif %}


{% if gitea_runner_enabled | default(true) %}
{% for i in range(1, (gitea_runner_count | default(4) | int) + 1) %}
  gitea-runner-dind-{{ i }}:
    image: docker:{{ gitea_dind_version | default('dind-rootless') }}
    container_name: gitea-runner-dind-{{ i }}
    privileged: true
    restart: always
    environment:
      - DOCKER_TLS_CERTDIR=
    volumes:
      - {{ gitea_dir }}/runner-{{ i }}-dind-data:/var/lib/docker
    networks:
      - default

  gitea-runner-{{ i }}:
    image: gitea/act_runner:{{ gitea_runner_version | default('latest') }}
    container_name: gitea-runner-{{ i }}
    restart: always
    environment:
      - GITEA_INSTANCE_URL=http://gitea:3000
      - GITEA_RUNNER_REGISTRATION_TOKEN={{ gitea_runner_registration_token | default('') }}
      - GITEA_RUNNER_NAME=gitea-runner-{{ i }}
      - DOCKER_HOST=tcp://gitea-runner-dind-{{ i }}:2375
      - DOCKER_API_VERSION={{ gitea_docker_api_version | default('1.40') }}
    volumes:
      - {{ gitea_dir }}/runner-{{ i }}-data:/data
    depends_on:
      - gitea
      - gitea-runner-dind-{{ i }}
    networks:
      - default
{% endfor %}
{% endif %}

networks:
  default:
  traefik_net:
    external: true
    name: {{ gitea_traefik_network }}
