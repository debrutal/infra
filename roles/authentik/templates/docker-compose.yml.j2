services:
  authentik-db:
    image: postgres:16-alpine
    container_name: authentik-db
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d {{ authentik_postgres_db }} -U {{ authentik_postgres_user }}"]
      start_period: 20s
      interval: 10s
      timeout: 5s
      retries: 5
    environment:
      POSTGRES_DB: "{{ authentik_postgres_db }}"
      POSTGRES_USER: "{{ authentik_postgres_user }}"
      POSTGRES_PASSWORD: "{{ authentik_postgres_password }}"
    volumes:
      - {{ authentik_dir }}/postgres:/var/lib/postgresql/data

  authentik-redis:
    image: redis:alpine
    container_name: authentik-redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      start_period: 20s
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - {{ authentik_dir }}/redis:/data

  authentik-server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    container_name: authentik-server
    restart: unless-stopped
    command: server
    depends_on:
      authentik-db:
        condition: service_healthy
      authentik-redis:
        condition: service_healthy
    environment:
      AUTHENTIK_SECRET_KEY: "{{ authentik_secret_key }}"
      AUTHENTIK_POSTGRESQL__HOST: "authentik-db"
      AUTHENTIK_POSTGRESQL__USER: "{{ authentik_postgres_user }}"
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_postgres_db }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ authentik_postgres_password }}"
      AUTHENTIK_REDIS__HOST: "authentik-redis"
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ authentik_admin_password }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: "{{ authentik_admin_email }}"
      AUTHENTIK_DISABLE_UPDATE_CHECK: "true"
      AUTHENTIK_ERROR_REPORTING__ENABLED: "false"
{% if authentik_otel_enabled | default(true) %}
      AUTHENTIK_LISTEN__METRICS: "0.0.0.0:9300"
{% endif %}
    volumes:
      - {{ authentik_dir }}/media:/media
      - {{ authentik_dir }}/custom-templates:/templates
    networks:
      - default
      - traefik_net
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.authentik.rule=Host(`{{ authentik_domain }}`)"
      - "traefik.http.routers.authentik.entrypoints={{ authentik_traefik_entrypoints }}"
{% if traefik_acme_enabled | default(true) %}
      - "traefik.http.routers.authentik.tls=true"
{% if authentik_traefik_certresolver is defined and authentik_traefik_certresolver %}
      - "traefik.http.routers.authentik.tls.certresolver={{ authentik_traefik_certresolver }}"
{% endif %}
{% endif %}
      - "traefik.http.services.authentik.loadbalancer.server.port=9000"
      - "traefik.http.routers.authentik-outpost.rule=HostRegexp(`{host:.+}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      - "traefik.http.routers.authentik-outpost.entrypoints={{ authentik_traefik_entrypoints }}"
      - "traefik.http.routers.authentik-outpost.service=authentik"
      - "traefik.http.routers.authentik-outpost.priority=150"
{% if traefik_acme_enabled | default(true) %}
      - "traefik.http.routers.authentik-outpost.tls=true"
{% endif %}
      - "kuma.authentik.http.name=Authentik"
      - "kuma.authentik.http.url=http://authentik-server:9000/-/health/live/"
      - "homepage.group=Security & Identity"
      - "homepage.name=Authentik"
      - "homepage.icon=authentik"
      - "homepage.href={{ authentik_site_url }}"
      - "homepage.description=Identity Provider & SSO"

  authentik-worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    container_name: authentik-worker
    restart: unless-stopped
    command: worker
    depends_on:
      authentik-db:
        condition: service_healthy
      authentik-redis:
        condition: service_healthy
    environment:
      AUTHENTIK_SECRET_KEY: "{{ authentik_secret_key }}"
      AUTHENTIK_POSTGRESQL__HOST: "authentik-db"
      AUTHENTIK_POSTGRESQL__USER: "{{ authentik_postgres_user }}"
      AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_postgres_db }}"
      AUTHENTIK_POSTGRESQL__PASSWORD: "{{ authentik_postgres_password }}"
      AUTHENTIK_REDIS__HOST: "authentik-redis"
      AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ authentik_admin_password }}"
      AUTHENTIK_BOOTSTRAP_EMAIL: "{{ authentik_admin_email }}"
      AUTHENTIK_DISABLE_UPDATE_CHECK: "true"
      AUTHENTIK_ERROR_REPORTING__ENABLED: "false"
    user: root
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ authentik_dir }}/media:/media
      - {{ authentik_dir }}/custom-templates:/templates
      - {{ authentik_dir }}/certs:/certs

networks:
  default:
  traefik_net:
    external: true
    name: {{ authentik_traefik_network }}
